# Runtime. "production" disables docs, rejects CORS *, and forbids DEV_SKIP_LICENSE.
APP_ENV=development
DEBUG=false

APP_URL=https://lingo.zaixos.com
API_URL=https://lingo-api.zaixos.com

HOST=127.0.0.1
PORT=8004

# Groq — server-side only. Never put this in the extension or VITE_* variables.
GROQ_API_KEY=your_groq_api_key_here
TRANSLATION_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=15
TRANSLATION_PROMPT_VERSION=v1

# true only on a local machine. Production must leave this false.
DEV_SKIP_LICENSE=true

# Lemon Squeezy — server-side only. Required in production.
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key_here
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_PRODUCT_ID=LINGO
LEMON_SQUEEZY_VARIANT_ID=
FIRST_MONTH_FREE=true

LICENSE_CACHE_TTL=900
INVALID_LICENSE_TTL_SECONDS=90

# In-process sliding windows. Per client IP.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRANSLATE_PER_MINUTE=40
RATE_LIMIT_LICENSE_PER_MINUTE=20

# Comma-separated browser origins. Do not set to * in production.
CORS_ORIGINS=
EXTENSION_IDS=

TRUST_PROXY=false

# No database is used. Do not set DATABASE_URL.
# Do not persist user translation text.
