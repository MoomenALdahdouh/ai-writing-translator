# Public build-time API origin for the extension.
# This is not a secret. Never put Groq or Lemon Squeezy keys here.
VITE_API_BASE_URL=https://lingo-api.zaixos.com

# Lemon Squeezy checkout URL (configured in Lemon Squeezy dashboard)
VITE_CHECKOUT_URL=https://store.zaixos.com/checkout/buy/[variant-id]

# Optional local usage debug overlay. Leave unset in production builds.
# VITE_USAGE_DEBUG=false
